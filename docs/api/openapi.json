{
  "openapi": "3.1.0",
  "info": {
    "title": "internal-system API",
    "version": "0.1.0",
    "description": "API の仕様書（OpenAPI 3.1）。API を足す・変えるときは、同じ変更の中でこの仕様書も直す（backend/src/openapi.test.ts が、実際のルートと食い違うと失敗にする）。Schemathesis（docs/testing/schemathesis.md）が、この仕様書から異常な入力を作って確かめる。"
  },
  "servers": [
    {
      "url": "http://localhost:5173",
      "description": "開発（npm run dev）"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "死活監視・動作確認",
        "responses": {
          "200": {
            "description": "動いている",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/sample-users": {
      "get": {
        "operationId": "listSampleUsers",
        "summary": "サンプルの利用者の一覧（ユーザー名の昇順、100件まで）",
        "responses": {
          "200": {
            "description": "一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "users"
                  ],
                  "properties": {
                    "users": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "$ref": "#/components/schemas/SampleUser"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "addSampleUser",
        "summary": "サンプルの利用者を1件追加する",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SampleUserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "追加した",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleUser"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "409": {
            "description": "同じユーザー名がすでにある（CONFLICT）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "appEnv"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "appEnv": {
            "type": "string",
            "description": "環境の名前（development・test・production）"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "エラーの共通の形（error-handler.ts）。code は AppError のコード（VALIDATION_ERROR など）",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "入力が正しくない項目の名前（VALIDATION_ERROR のとき）"
          }
        }
      },
      "SampleUser": {
        "type": "object",
        "required": [
          "username"
        ],
        "properties": {
          "username": {
            "type": "string"
          }
        }
      },
      "SampleUserInput": {
        "type": "object",
        "required": [
          "username"
        ],
        "additionalProperties": true,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9_]+$",
            "description": "英数字と _ だけ（backend/src/routes/sample-users.ts の zod の検証と同じ）"
          }
        }
      }
    },
    "responses": {
      "ForbiddenOrigin": {
        "description": "送信元（Origin）が許可されていない（状態を変える要求。C-28）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "入力が正しくない（VALIDATION_ERROR）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
