# 環境変数の項目の一覧（C-05）。開発は .env.development、検証は .env.test にコピーして値を入れる。
# 実際の値が入ったファイルは Git に入れない。チャットにも書かない。項目の説明は docs/secrets.md にある。
# 足りない項目は、npm run env:check で確かめられる。

# 環境の名前
APP_ENV=development

# 状態を変える要求を許可する送信元（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5173

# Docker で動かすときに、手元で開くポート（docker-compose.yml が読む）
APP_PORT=5173

# 初代全体管理者の初回セットアップ用のトークン（32バイトの乱数の base64url。ちょうど43文字）。値は利用者が .env.development・.env.test に入れる
# 作り方：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 本番は、セットアップが終わったら運用者が削除する（docs/secrets.md）
SETUP_TOKEN=

# 本名（個人情報）を暗号化する鍵（AES-256-GCM。32バイトの乱数の base64url）。作り方は SETUP_TOKEN と同じで、別の値にする
# 紛失すると保存済みの本名を復号できない。ローテーションの扱いは ADR-0013
PII_ENCRYPTION_KEY=
