    "backend/src/lib/throttle-policy.ts",
    "backend/src/lib/session-token.ts",
    "backend/src/db/auth.repository.ts",
    "backend/src/db/credential.repository.ts",
    "backend/src/db/audit-log.repository.ts",
    "backend/src/db/session.repository.ts",
    "shared/client-rules.ts",
    "backend/src/db/client.repository.ts",
    "backend/src/db/client-rate-limit.repository.ts",
    "backend/src/routes/clients.ts",
