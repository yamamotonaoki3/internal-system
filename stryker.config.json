{
  "testRunner": "vitest",
  "mutate": [
    "backend/src/services/**/*.ts",
    "backend/src/lib/authorization.ts",
    "backend/src/lib/password.ts",
    "backend/src/lib/password-policy.ts",
    "shared/password-rules.ts",
    "shared/reauth-policy.ts",
