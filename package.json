{
  "name": "internal-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/run-local.ts development vite",
    "dev:test": "node scripts/run-local.ts test vite",
    "build": "node scripts/run-local.ts build vite build",
    "preview": "node scripts/run-local.ts development vite preview",
    "types": "node scripts/run-local.ts development wrangler types",
    "types:test": "node scripts/run-local.ts test wrangler types",
    "predev": "npm run env:check -- development && npm run types",
    "predev:test": "npm run env:check -- test && npm run types:test",
    "docker:up:local": "node scripts/compose-local.ts development up -d",
    "docker:up:test": "node scripts/compose-local.ts test up -d",
    "docker:down:local": "node scripts/compose-local.ts development down",
    "docker:down:test": "node scripts/compose-local.ts test down",
    "test": "node scripts/run-local.ts test vitest run",
    "pretest": "npm run env:check -- test && npm run types:test",
    "test:e2e": "node scripts/run-local.ts test playwright test",
    "pretest:e2e": "npm run env:check -- test && npm run db:reset:test && node scripts/db-local.ts test seed-file e2e/seeds/health.sql",
    "check": "npm run check:app && npm run security",
    "check:app": "npm run test:safety && npm run lint && npm run typecheck && npm run format:check && npm run deps:check && npm run dup:check && npm test && npm run audit:prod",
    "security": "node scripts/security-check.mjs",
    "security:semgrep": "node scripts/security-check.mjs semgrep",
    "security:secrets": "node scripts/security-check.mjs secrets",
    "security:osv": "node scripts/security-check.mjs osv",
    "test:safety": "node scripts/test-safety.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "pretypecheck": "npm run types",
    "format:check": "prettier --check .",
    "deps:check": "depcruise frontend/src backend/src --config .dependency-cruiser.cjs",
    "dup:check": "jscpd frontend/src backend/src",
    "mutation": "stryker run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "env:check": "node scripts/env-check.mjs",
    "db:generate": "node scripts/db-local.ts development generate",
    "db:migrate:local": "node scripts/db-local.ts development migrate",
    "db:seed:local": "node scripts/db-local.ts development seed",
    "db:reset:local": "node scripts/db-local.ts development reset",
    "db:cleanup": "node scripts/db-local.ts development cleanup",
    "db:migrate:test": "node scripts/db-local.ts test migrate",
    "db:seed:test": "node scripts/db-local.ts test seed",
    "db:reset:test": "node scripts/db-local.ts test reset",
    "db:cleanup:test": "node scripts/db-local.ts test cleanup"
  },
  "overrides": {
    "@typeschema/zod": {
      "zod": "$zod"
    }
  },
  "allowScripts": {
    "msw": false,
    "esbuild": true,
    "workerd": true
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "axios": "1.20.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.5.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jscpd": "5.4.1",
    "jsdom": "30.1.2",
    "msw": "3.0.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
